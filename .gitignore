# Build
/target/
**/*.rs.bk
rustc-ice-*.txt

# Lockfile — library crate (bins/apps often commit; libs typically do not)
Cargo.lock

# Docs / site outputs
site/
/doc/

# mdBook assembled chapters (copied from docs/ + crate README by docs-prepare).
# Keep hand-authored book pages tracked.
book/**
!book/SUMMARY.md
!book/whoami.md
!book/getting-started.md

# Coverage / profiling
coverage/
lcov.info
*.prof
*.profraw

# Logs & temp
*.log
.tmp/
tmp/
.system_generated/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Environment / secrets (never commit tokens or API keys)
.env
.env.*
.env.local
!.env.example
*.pem
*.key
*HERMERS_API_KEY*
*CARGO_REGISTRY_TOKEN*
